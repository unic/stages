      "import": "./dist/studio.js"
    },
    "./portable.schema.json": "./portable.schema.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "portable.schema.json"
  ],
  "devDependencies": {
    "@stages/core": "file:../core"

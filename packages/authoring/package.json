{
  "name": "@stages/authoring",
  "version": "1.0.0-alpha.0",
  "description": "Portable Stages form definitions and framework-neutral runtime compiler",
  "license": "MIT",
  "author": "Fredi Bach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unic/stages.git",
    "directory": "packages/authoring"
  },
  "homepage": "https://github.com/unic/stages#readme",
  "bugs": {
    "url": "https://github.com/unic/stages/issues"
  },
  "keywords": [
    "forms",
    "wizard",
    "portable",
    "typescript"
  ],

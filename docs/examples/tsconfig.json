{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "paths": {
      "@stages/core": ["../../packages/core/src/index.ts"],
      "@stages/authoring": ["../../packages/authoring/src/index.ts"],
      "@stages/dom": ["../../packages/dom/src/index.ts"],
      "@stages/react": ["../../packages/react/src/index.tsx"],
      "@stages/test-kit": ["../../packages/test-kit/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../../packages/core/src/**/*.ts", "../../packages/dom/src/**/*.ts", "../../packages/react/src/**/*.tsx", "../../packages/test-kit/src/**/*.ts"]
}
